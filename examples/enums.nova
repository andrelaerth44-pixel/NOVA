enum Status {
    Ready
    Running
    Failed(string)
}

result = Some(42)
ok = Ok("done")

match result {
    Some(value) {
        print value
    },
    None {
        print "none"
    },
    else {
        print "other"
    }
}

print is_some(result)
print unwrap_or(result, 0)
print is_ok(ok)
print unwrap(ok)
