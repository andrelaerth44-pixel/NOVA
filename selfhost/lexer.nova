struct Token {
    kind: string
    lexeme: string
}

fn make_token(kind: string, lexeme: string) -> Token {
    return Token { kind: kind, lexeme: lexeme }
}

fn is_space(code: f64) -> bool {
    return code == 9 || code == 10 || code == 13 || code == 32
}

fn is_digit(code: f64) -> bool {
    return code >= 48 && code <= 57
}

fn is_alpha(code: f64) -> bool {
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

fn is_alpha_num(code: f64) -> bool {
    return is_alpha(code) || is_digit(code)
}

fn keyword_kind(text: string) -> string {
    if text == "fn" { return "fn" }
    if text == "let" { return "let" }
    if text == "return" { return "return" }
    if text == "if" { return "if" }
    if text == "else" { return "else" }
    if text == "while" { return "while" }
    if text == "for" { return "for" }
    if text == "in" { return "in" }
    if text == "match" { return "match" }
    if text == "struct" { return "struct" }
    if text == "enum" { return "enum" }
    if text == "import" { return "import" }
    if text == "true" { return "true" }
    if text == "false" { return "false" }
    if text == "print" { return "print" }
    return "ident"
}

fn lex(source: string) -> Token[] {
    tokens = []
    i = 0
    n = len(source)

    while i < n {
        c = source[i]
        code = ord(c)

        if is_space(code) {
            i = i + 1
        } else if c == "/" && i + 1 < n && source[i + 1] == "/" {
            i = i + 2
            while i < n && ord(source[i]) != 10 {
                i = i + 1
            }
        } else if is_alpha(code) {
            start = i
            i = i + 1
            while i < n && is_alpha_num(ord(source[i])) {
                i = i + 1
            }
            text = ""
            j = start
            while j < i {
                text = text + source[j]
                j = j + 1
            }
            tokens = push(tokens, make_token(keyword_kind(text), text))
        } else if is_digit(code) {
            start = i
            i = i + 1
            while i < n && is_digit(ord(source[i])) {
                i = i + 1
            }
            if i < n && source[i] == "." && i + 1 < n && is_digit(ord(source[i + 1])) {
                i = i + 1
                while i < n && is_digit(ord(source[i])) {
                    i = i + 1
                }
            }
            text = ""
            j = start
            while j < i {
                text = text + source[j]
                j = j + 1
            }
            tokens = push(tokens, make_token("number", text))
        } else if code == 34 {
            i = i + 1
            text = ""
            while i < n && ord(source[i]) != 34 {
                if ord(source[i]) == 92 && i + 1 < n {
                    next = source[i + 1]
                    if next == "n" {
                        text = text + chr(10)
                    } else if next == "t" {
                        text = text + chr(9)
                    } else if next == "r" {
                        text = text + chr(13)
                    } else {
                        text = text + next
                    }
                    i = i + 2
                } else {
                    text = text + source[i]
                    i = i + 1
                }
            }
            if i < n {
                i = i + 1
            }
            tokens = push(tokens, make_token("string", text))
        } else {
            two = ""
            if i + 1 < n {
                two = c + source[i + 1]
            }

            if two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "->" || two == "&&" || two == "||" {
                tokens = push(tokens, make_token(two, two))
                i = i + 2
            } else {
                kind = c
                if c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]" ||
                   c == "," || c == ":" || c == ";" || c == "." || c == "+" ||
                   c == "-" || c == "*" || c == "/" || c == "%" || c == "=" ||
                   c == "<" || c == ">" || c == "!" || c == "?" {
                    tokens = push(tokens, make_token(kind, c))
                    i = i + 1
                } else {
                    i = i + 1
                }
            }
        }
    }

    tokens = push(tokens, make_token("eof", ""))
    return tokens
}
