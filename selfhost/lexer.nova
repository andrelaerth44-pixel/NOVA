struct Token {
    kind: string
    lexeme: string
}

fn make_token(kind: string, lexeme: string) -> Token {
    return Token { kind: kind, lexeme: lexeme }
}

fn is_space(code: f64) -> bool {
    return code == 9 or code == 10 or code == 13 or code == 32
}

fn is_digit(code: f64) -> bool {
    return code >= 48 and code <= 57
}

fn is_alpha(code: f64) -> bool {
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95
}

fn is_alpha_num(code: f64) -> bool {
    return is_alpha(code) or is_digit(code)
}

fn keyword_kind(text: string) -> string {
    if text == "fn" { return "fn" }
    if text == "let" { return "let" }
    if text == "return" { return "return" }
    if text == "if" { return "if" }
    if text == "else" { return "else" }
    if text == "while" { return "while" }
    if text == "for" { return "for" }
    if text == "in" { return "in" }
    if text == "match" { return "match" }
    if text == "struct" { return "struct" }
    if text == "enum" { return "enum" }
    if text == "import" { return "import" }
    if text == "true" { return "true" }
    if text == "false" { return "false" }
    if text == "null" { return "null" }
    if text == "print" { return "print" }
    if text == "and" { return "and" }
    if text == "or" { return "or" }
    return "ident"
}

fn lex(source: string) -> Token[] {
    tokens = []
    i = 0
    n = len(source)

    while i < n {
        c = source[i]
        code = ord(c)

        if is_space(code) {
            i = i + 1
        } else {
            comment = c == "/" and i + 1 < n and source[i + 1] == "/"
            if comment {
                i = i + 2
                while i < n and ord(source[i]) != 10 {
                    i = i + 1
                }
            } else {
                alpha = is_alpha(code)
                digit = is_digit(code)

                if alpha {
                    start = i
                    i = i + 1
                    while i < n and is_alpha_num(ord(source[i])) {
                        i = i + 1
                    }
                    text = ""
                    j = start
                    while j < i {
                        text = text + source[j]
                        j = j + 1
                    }
                    tokens = push(tokens, make_token(keyword_kind(text), text))
                } else {
                    if digit {
                        start = i
                        i = i + 1
                        while i < n and is_digit(ord(source[i])) {
                            i = i + 1
                        }
                        decimal = i < n and source[i] == "." and i + 1 < n and is_digit(ord(source[i + 1]))
                        if decimal {
                            i = i + 1
                            while i < n and is_digit(ord(source[i])) {
                                i = i + 1
                            }
                        }
                        text = ""
                        j = start
                        while j < i {
                            text = text + source[j]
                            j = j + 1
                        }
                        tokens = push(tokens, make_token("number", text))
                    } else {
                        string_start = code == 34
                        if string_start {
                            i = i + 1
                            text = ""
                            while i < n and ord(source[i]) != 34 {
                                escaped = ord(source[i]) == 92 and i + 1 < n
                                if escaped {
                                    next = source[i + 1]
                                    if next == "n" {
                                        text = text + chr(10)
                                    } else {
                                        if next == "t" {
                                            text = text + chr(9)
                                        } else {
                                            if next == "r" {
                                                text = text + chr(13)
                                            } else {
                                                text = text + next
                                            }
                                        }
                                    }
                                    i = i + 2
                                } else {
                                    text = text + source[i]
                                    i = i + 1
                                }
                            }
                            if i < n {
                                i = i + 1
                            }
                            tokens = push(tokens, make_token("string", text))
                        } else {
                            two = ""
                            if i + 1 < n {
                                two = c + source[i + 1]
                            }

                            double_operator = two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "->"
                            if double_operator {
                                tokens = push(tokens, make_token(two, two))
                                i = i + 2
                            } else {
                                kind = c
                                punctuation = c == "(" or c == ")" or c == "{" or c == "}" or c == "[" or c == "]" or
                                    c == "," or c == ":" or c == ";" or c == "." or c == "+" or
                                    c == "-" or c == "*" or c == "/" or c == "%" or c == "=" or
                                    c == "<" or c == ">" or c == "!" or c == "?"
                                if punctuation {
                                    tokens = push(tokens, make_token(kind, c))
                                    i = i + 1
                                } else {
                                    i = i + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    tokens = push(tokens, make_token("eof", ""))
    return tokens
}