struct Node {
    kind: string
    text: string
    children: Node[]
}

fn make_node(kind: string, text: string) -> Node {
    return Node { kind: kind, text: text, children: [] }
}

fn add_child(node: Node, child: Node) -> Node {
    node.children = push(node.children, child)
    return node
}

struct ParserState {
    tokens: Token[]
    pos: f64
}

fn position(state: ParserState) -> f64 {
    return state.pos
}

fn token_at(state: ParserState, offset: f64) -> Token {
    p = state.pos + offset
    return state.tokens[p]
}

fn peek_kind(state: ParserState) -> string {
    return token_at(state, 0).kind
}

fn peek_text(state: ParserState) -> string {
    return token_at(state, 0).lexeme
}

fn take_token(state: ParserState) -> Token {
    token = token_at(state, 0)
    state.pos = position(state) + 1
    return token
}

fn accept(state: ParserState, kind: string) -> bool {
    if peek_kind(state) == kind {
        take_token(state)
        return true
    }
    return false
}

fn expect(state: ParserState, kind: string) {
    accept(state, kind)
}

fn precedence(kind: string) -> f64 {
    if kind == "or" { return 1 }
    if kind == "and" { return 2 }
    if kind == "==" or kind == "!=" { return 3 }
    if kind == "<" or kind == "<=" or kind == ">" or kind == ">=" { return 4 }
    if kind == "+" or kind == "-" { return 5 }
    if kind == "*" or kind == "/" or kind == "%" { return 6 }
    return 0
}

fn parse_list(state: ParserState, closing: string) -> Node[] {
    items = []
    more = true

    while more and peek_kind(state) != closing and peek_kind(state) != "eof" {
        items = push(items, parse_expression(state, 1))
        if !accept(state, ",") {
            more = false
        }
    }

    expect(state, closing)
    return items
}

fn parse_atom(state: ParserState) -> Node {
    kind = peek_kind(state)

    if kind == "-" or kind == "!" {
        op = take_token(state)
        unary = make_node("unary", op.lexeme)
        return add_child(unary, parse_atom(state))
    }

    if kind == "number" {
        token = take_token(state)
        return make_node("number", token.lexeme)
    }

    if kind == "string" {
        token = take_token(state)
        return make_node("string", token.lexeme)
    }

    if kind == "true" or kind == "false" {
        token = take_token(state)
        return make_node("bool", token.lexeme)
    }

    if kind == "[" {
        take_token(state)
        node = make_node("array", "")
        values = parse_list(state, "]")
        i = 0
        while i < len(values) {
            node = add_child(node, values[i])
            i = i + 1
        }
        return node
    }

    if kind == "ident" {
        token = take_token(state)
        node = make_node("ident", token.lexeme)

        if token.lexeme == "map" and peek_kind(state) == "{" {
            take_token(state)
            node.kind = "map"
            more = true
            while more and peek_kind(state) != "}" and peek_kind(state) != "eof" {
                key = parse_expression(state, 1)
                expect(state, ":")
                value = parse_expression(state, 1)
                pair = make_node("pair", "")
                pair = add_child(pair, key)
                pair = add_child(pair, value)
                node = add_child(node, pair)
                if !accept(state, ",") {
                    more = false
                }
            }
            expect(state, "}")
            return node
        }

        if token.lexeme == "set" and peek_kind(state) == "{" {
            take_token(state)
            node.kind = "set"
            values = parse_list(state, "}")
            i = 0
            while i < len(values) {
                node = add_child(node, values[i])
                i = i + 1
            }
            return node
        }

        if peek_kind(state) == "{" {
            take_token(state)
            node.kind = "struct"
            more = true
            while more and peek_kind(state) != "}" and peek_kind(state) != "eof" {
                field = take_token(state)
                field_node = make_node("field_init", field.lexeme)
                expect(state, ":")
                field_node = add_child(field_node, parse_expression(state, 1))
                node = add_child(node, field_node)
                if !accept(state, ",") {
                    more = false
                }
            }
            expect(state, "}")
            return node
        }

        return node
    }

    if accept(state, "(") {
        node = parse_expression(state, 1)
        expect(state, ")")
        return node
    }

    token = take_token(state)
    return make_node("unknown", token.lexeme)
}

fn parse_postfix(state: ParserState) -> Node {
    node = parse_atom(state)
    done = false

    while !done and peek_kind(state) != "eof" {
        if accept(state, "(") {
            call = make_node("call", node.text)
            more = true
            if node.kind != "ident" {
                call.kind = "call_value"
                call = add_child(call, node)
            }

            while more and peek_kind(state) != ")" and peek_kind(state) != "eof" {
                call = add_child(call, parse_expression(state, 1))
                if !accept(state, ",") {
                    more = false
                }
            }
            expect(state, ")")
            node = call
        } else {
            index_open = accept(state, "[")
            if index_open {
                index = make_node("index", "")
                index = add_child(index, node)
                index = add_child(index, parse_expression(state, 1))
                expect(state, "]")
                node = index
            } else {
                dot_open = accept(state, ".")
                if dot_open {
                    field = take_token(state)
                    access = make_node("field", field.lexeme)
                    access = add_child(access, node)
                    node = access
                } else {
                    done = true
                }
            }
        }
    }

    return node
}

fn parse_primary(state: ParserState) -> Node {
    return parse_postfix(state)
}

fn parse_expression(state: ParserState, min_prec: f64) -> Node {
    left = parse_primary(state)
    done = false

    while !done and peek_kind(state) != "eof" {
        op = peek_kind(state)
        prec = precedence(op)
        if prec < min_prec or prec == 0 {
            done = true
        } else {
            take_token(state)
            right = parse_expression(state, prec + 1)
            binary = make_node("binary", op)
            binary = add_child(binary, left)
            binary = add_child(binary, right)
            left = binary
        }
    }

    return left
}

fn parse_block(state: ParserState) -> Node {
    block = make_node("block", "")
    expect(state, "{")
    done = false

    while !done and peek_kind(state) != "eof" {
        if peek_kind(state) == "}" {
            done = true
        } else {
            block = add_child(block, parse_statement(state))
            accept(state, ";")
        }
    }

    expect(state, "}")
    return block
}

fn parse_statement(state: ParserState) -> Node {
    kind = peek_kind(state)

    if kind == "import" {
        take_token(state)
        path = take_token(state)
        return make_node("import", path.lexeme)
    }

    if kind == "fn" {
        take_token(state)
        name = take_token(state)
        fn_node = make_node("fn", name.lexeme)

        if accept(state, "(") {
            more = true
            while more and peek_kind(state) != ")" and peek_kind(state) != "eof" {
                param = take_token(state)
                if param.kind == "ident" {
                    fn_node = add_child(fn_node, make_node("param", param.lexeme))
                }
                if peek_kind(state) == ":" {
                    take_token(state)
                    take_token(state)
                }
                if !accept(state, ",") {
                    more = false
                }
            }
            expect(state, ")")
        }

        if accept(state, "->") {
            take_token(state)
        }

        body = parse_block(state)
        i = 0
        while i < len(body.children) {
            fn_node = add_child(fn_node, body.children[i])
            i = i + 1
        }
        return fn_node
    }

    if kind == "struct" {
        take_token(state)
        name = take_token(state)
        node = make_node("struct_decl", name.lexeme)
        body = parse_block(state)
        i = 0
        while i < len(body.children) {
            node = add_child(node, body.children[i])
            i = i + 1
        }
        return node
    }

    if kind == "enum" {
        take_token(state)
        name = take_token(state)
        node = make_node("enum_decl", name.lexeme)
        expect(state, "{")
        done = false
        while !done and peek_kind(state) != "eof" {
            if peek_kind(state) == "}" {
                done = true
            } else {
                variant = take_token(state)
                variant_node = make_node("variant", variant.lexeme)
                if accept(state, "(") {
                    type_token = take_token(state)
                    variant_node = add_child(variant_node, make_node("type", type_token.lexeme))
                    expect(state, ")")
                }
                node = add_child(node, variant_node)
                accept(state, ",")
            }
        }
        expect(state, "}")
        return node
    }

    if kind == "if" {
        take_token(state)
        node = make_node("if", "")
        node = add_child(node, parse_expression(state, 1))
        node = add_child(node, parse_block(state))
        if peek_kind(state) == "else" {
            take_token(state)
            node = add_child(node, parse_block(state))
        }
        return node
    }

    if kind == "while" {
        take_token(state)
        node = make_node("while", "")
        node = add_child(node, parse_expression(state, 1))
        node = add_child(node, parse_block(state))
        return node
    }

    if kind == "for" {
        take_token(state)
        name = take_token(state)
        node = make_node("for", name.lexeme)
        expect(state, "in")
        node = add_child(node, parse_expression(state, 1))
        node = add_child(node, parse_block(state))
        return node
    }

    if kind == "match" {
        take_token(state)
        node = make_node("match", "")
        node = add_child(node, parse_expression(state, 1))
        expect(state, "{")
        done = false
        while !done and peek_kind(state) != "eof" {
            if peek_kind(state) == "}" {
                done = true
            } else {
                pattern = take_token(state)
                arm = make_node("arm", pattern.lexeme)
                if accept(state, "(") {
                    binding = take_token(state)
                    arm = add_child(arm, make_node("binding", binding.lexeme))
                    expect(state, ")")
                }
                arm = add_child(arm, parse_block(state))
                node = add_child(node, arm)
                accept(state, ",")
            }
        }
        expect(state, "}")
        return node
    }

    if kind == "return" {
        take_token(state)
        result = make_node("return", "")
        return add_child(result, parse_expression(state, 1))
    }

    if kind == "print" {
        take_token(state)
        result = make_node("print", "")
        return add_child(result, parse_expression(state, 1))
    }

    if kind == "let" {
        take_token(state)
        name = take_token(state)
        let_node = make_node("let", name.lexeme)
        if peek_kind(state) == ":" {
            take_token(state)
            take_token(state)
        }
        expect(state, "=")
        return add_child(let_node, parse_expression(state, 1))
    }

    if kind == "ident" {
        expr = parse_expression(state, 1)
        if expr.kind == "ident" and accept(state, "=") {
            assign = make_node("assign", expr.text)
            return add_child(assign, parse_expression(state, 1))
        }
        if (expr.kind == "field" or expr.kind == "index") and accept(state, "=") {
            assign = make_node("assign_target", "")
            assign = add_child(assign, expr)
            return add_child(assign, parse_expression(state, 1))
        }
        expr_node = make_node("expr", "")
        return add_child(expr_node, expr)
    }

    token = take_token(state)
    return make_node("token", token.lexeme)
}

fn parse_program(tokens: Token[]) -> Node {
    state = ParserState { tokens: tokens, pos: 0 }
    program = make_node("program", "")
    done = false

    while !done {
        if peek_kind(state) == "eof" {
            done = true
        } else {
            program = add_child(program, parse_statement(state))
            accept(state, ";")
        }
    }

    return program
}
