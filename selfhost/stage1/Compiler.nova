fn compile(source) {
    lexed = lex(source)
    if map_get(lexed, "ok") == false {
        return format(map_get(lexed, "errors"))
    }

    parsed = parse(source)
    if map_get(parsed, "ok") == false {
        return format(map_get(parsed, "errors"))
    }

    ir = lower(map_get(parsed, "ast"))
    ssa = run(ir)
    errors = map_get(ssa, "errors")
    if len(errors) > 0 {
        return format(errors)
    }

    return BackendX86.build(ssa)
}
