import "AST.nova"
import "Lexer.nova"
import "Parser.nova"
import "IR.nova"
import "SSA.nova"

source = read_file("selfhost/fixtures/hello.nova")
lexed = lex_source(source)
parsed = parser_source(source)
ir = ir_lower(map_get(parsed, "ast"))
ssa = ssa_run(ir)
print json_stringify(map { "lexed": lexed, "parsed": parsed, "ir": ir, "ssa": ssa })

print json_stringify(map {
    "variable_a": ast_variable("a"),
    "variable_b": ast_variable("b"),
    "expression": parser_source("a + b")
})

lex_simple = lex_source("a + b")
p_simple = parser_state(map_get(lex_simple, "tokens"))
t0 = parser_advance(p_simple)
t1 = parser_advance(p_simple)
t2 = parser_advance(p_simple)
print json_stringify([t0, t1, t2])

p_primary = parser_state(map_get(lex_simple, "tokens"))
primary0 = parser_primary(p_primary)
print json_stringify(primary0)

print json_stringify(ast_binary("+", ast_variable("a"), ast_variable("b")))
p_term = parser_state(map_get(lex_simple, "tokens"))
term0 = parser_term(p_term)
print json_stringify(term0)
