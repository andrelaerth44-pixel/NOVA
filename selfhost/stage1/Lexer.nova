fn token(kind, text) {
    return map { "kind": kind, "text": text }
}

fn is_space(c) {
    return c == " " or c == "\n" or c == "\r" or c == "\t"
}

fn is_digit(c) {
    return c >= "0" and c <= "9"
}

fn is_alpha(c) {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

fn is_alnum(c) {
    return is_alpha(c) or is_digit(c)
}

fn keyword(word) {
    if word == "fn" { return "fn" }
    if word == "let" { return "let" }
    if word == "return" { return "return" }
    if word == "print" { return "print" }
    if word == "true" { return "true" }
    if word == "false" { return "false" }
    if word == "if" { return "if" }
    if word == "else" { return "else" }
    if word == "while" { return "while" }
    return "ident"
}

fn lex(source) {
    tokens = []
    i = 0
    n = len(source)

    while i < n {
        c = source[i]

        if is_space(c) {
            i = i + 1
        } else if c == "#" {
            i = i + 1
            while i < n and source[i] != "\n" {
                i = i + 1
            }
        } else if is_digit(c) {
            text = ""
            while i < n and (is_digit(source[i]) or source[i] == ".") {
                text = text + source[i]
                i = i + 1
            }
            tokens = tokens + [token("number", text)]
        } else if is_alpha(c) {
            text = ""
            while i < n and is_alnum(source[i]) {
                text = text + source[i]
                i = i + 1
            }
            tokens = tokens + [token(keyword(text), text)]
        } else if c == """ {
            i = i + 1
            text = ""
            closed = false
            while i < n {
                c2 = source[i]
                if c2 == """ {
                    closed = true
                    i = i + 1
                    break
                }
                if c2 == "\\" and i + 1 < n {
                    i = i + 1
                    escaped = source[i]
                    if escaped == "n" { text = text + "\n" }
                    else if escaped == "r" { text = text + "\r" }
                    else if escaped == "t" { text = text + "\t" }
                    else { text = text + escaped }
                    i = i + 1
                } else {
                    text = text + c2
                    i = i + 1
                }
            }
            if closed {
                tokens = tokens + [token("string", text)]
            } else {
                return map { "ok": false, "errors": ["unterminated string literal"], "tokens": tokens }
            }
        } else if c == "+" {
            tokens = tokens + [token("plus", "+")]
            i = i + 1
        } else if c == "-" {
            tokens = tokens + [token("minus", "-")]
            i = i + 1
        } else if c == "*" {
            tokens = tokens + [token("star", "*")]
            i = i + 1
        } else if c == "/" {
            tokens = tokens + [token("slash", "/")]
            i = i + 1
        } else if c == "%" {
            tokens = tokens + [token("percent", "%")]
            i = i + 1
        } else if c == "=" and i + 1 < n and source[i + 1] == "=" {
            tokens = tokens + [token("eqeq", "==")]
            i = i + 2
        } else if c == "!" and i + 1 < n and source[i + 1] == "=" {
            tokens = tokens + [token("ne", "!=")]
            i = i + 2
        } else if c == "<" and i + 1 < n and source[i + 1] == "=" {
            tokens = tokens + [token("le", "<=")]
            i = i + 2
        } else if c == ">" and i + 1 < n and source[i + 1] == "=" {
            tokens = tokens + [token("ge", ">=")]
            i = i + 2
        } else if c == "=" {
            tokens = tokens + [token("eq", "=")]
            i = i + 1
        } else if c == "<" {
            tokens = tokens + [token("lt", "<")]
            i = i + 1
        } else if c == ">" {
            tokens = tokens + [token("gt", ">")]
            i = i + 1
        } else if c == "!" {
            tokens = tokens + [token("bang", "!")]
            i = i + 1
        } else if c == "(" {
            tokens = tokens + [token("lparen", "(")]
            i = i + 1
        } else if c == ")" {
            tokens = tokens + [token("rparen", ")")]
            i = i + 1
        } else if c == "{" {
            tokens = tokens + [token("lbrace", "{")]
            i = i + 1
        } else if c == "}" {
            tokens = tokens + [token("rbrace", "}")]
            i = i + 1
        } else if c == "," {
            tokens = tokens + [token("comma", ",")]
            i = i + 1
        } else if c == ";" {
            tokens = tokens + [token("semi", ";")]
            i = i + 1
        } else {
            return map { "ok": false, "errors": ["unexpected character " + c], "tokens": tokens }
        }
    }

    tokens = tokens + [token("eof", "")]
    return map { "ok": true, "errors": [], "tokens": tokens }
}
