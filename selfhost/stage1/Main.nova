import "Diagnostics.nova"
import "AST.nova"
import "Lexer.nova"
import "Parser.nova"
import "IR.nova"
import "SSA.nova"
import "BackendX86.nova"
import "Compiler.nova"

fn main() {
    source = read_file("selfhost/fixtures/hello.nova")
    assembly = Compiler.compile(source)
    write_file("target/nova-stage1-hello.s", assembly)
    print "NOVA Stage 1 compiler emitted target/nova-stage1-hello.s"
}
