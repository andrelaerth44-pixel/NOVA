fn state(tokens) {
    return map { "tokens": tokens, "pos": 0 }
}

fn peek(p) {
    pos = map_get(p, "pos")
    tokens = map_get(p, "tokens")
    return tokens[pos]
}

fn advance(p) {
    value = peek(p)
    map_set(p, "pos", map_get(p, "pos") + 1)
    return value
}

fn kind(p) {
    return map_get(peek(p), "kind")
}

fn text(p) {
    return map_get(peek(p), "text")
}

fn accept(p, wanted) {
    if kind(p) == wanted {
        advance(p)
        return true
    }
    return false
}

fn expect(p, wanted) {
    if accept(p, wanted) {
        return ""
    }
    return "expected " + wanted + ", got " + kind(p)
}

fn parse_primary(p) {
    k = kind(p)
    if k == "number" {
        return number(map_get(advance(p), "text"))
    }
    if k == "string" {
        return string(map_get(advance(p), "text"))
    }
    if k == "true" or k == "false" {
        value = map_get(advance(p), "text")
        return number(if value == "true" { "1" } else { "0" })
    }
    if k == "ident" {
        name = map_get(advance(p), "text")
        if accept(p, "lparen") {
            args = []
            if not_accept(p, "rparen") {
                loop = true
                while loop {
                    args = array_push(args, parse_expr(p))
                    if accept(p, "rparen") {
                        loop = false
                    } else {
                        err = expect(p, "comma")
                        if err != "" { return string("ERROR:" + err) }
                    }
                }
            }
            return call(name, args)
        }
        return variable(name)
    }
    if accept(p, "lparen") {
        value = parse_expr(p)
        expect(p, "rparen")
        return value
    }
    if accept(p, "minus") {
        return unary("-", parse_primary(p))
    }
    if accept(p, "bang") {
        return unary("!", parse_primary(p))
    }
    return string("ERROR:unexpected " + k)
}

fn not_accept(p, wanted) {
    if kind(p) == wanted {
        advance(p)
        return false
    }
    return true
}

fn parse_factor(p) {
    left = parse_primary(p)
    while kind(p) == "star" or kind(p) == "slash" or kind(p) == "percent" {
        op = map_get(advance(p), "text")
        right = parse_primary(p)
        left = binary(op, left, right)
    }
    return left
}

fn parse_term(p) {
    left = parse_factor(p)
    while kind(p) == "plus" or kind(p) == "minus" {
        op = map_get(advance(p), "text")
        right = parse_factor(p)
        left = binary(op, left, right)
    }
    return left
}

fn parse_compare(p) {
    left = parse_term(p)
    while kind(p) == "lt" or kind(p) == "le" or kind(p) == "gt" or kind(p) == "ge" or kind(p) == "eqeq" or kind(p) == "ne" {
        op = map_get(advance(p), "text")
        right = parse_term(p)
        left = binary(op, left, right)
    }
    return left
}

fn parse_expr(p) {
    return parse_compare(p)
}

fn parse_block(p) {
    body = []
    err = expect(p, "lbrace")
    if err != "" { return [] }
    while kind(p) != "rbrace" and kind(p) != "eof" {
        body = array_push(body, parse_stmt(p))
        accept(p, "semi")
    }
    accept(p, "rbrace")
    return body
}

fn parse_fn(p) {
    advance(p)
    name = text(p)
    expect(p, "ident")
    expect(p, "lparen")
    params = []
    if kind(p) != "rparen" {
        loop = true
        while loop {
            params = array_push(params, text(p))
            expect(p, "ident")
            if accept(p, "rparen") { loop = false }
            else { expect(p, "comma") }
        }
    } else {
        advance(p)
    }
    body = parse_block(p)
    return fn_decl(name, params, body)
}

fn parse_stmt(p) {
    k = kind(p)
    if k == "fn" { return parse_fn(p) }
    if k == "let" {
        advance(p)
        name = text(p)
        expect(p, "ident")
        expect(p, "eq")
        return let_stmt(name, parse_expr(p))
    }
    if k == "print" {
        advance(p)
        return print_stmt(parse_expr(p))
    }
    if k == "return" {
        advance(p)
        return return_stmt(parse_expr(p))
    }
    if k == "ident" {
        name = text(p)
        advance(p)
        if accept(p, "eq") {
            return assign(name, parse_expr(p))
        }
        map_set(p, "pos", map_get(p, "pos") - 1)
    }
    return expr_stmt(parse_expr(p))
}

fn parse(source) {
    tokens_result = lex(source)
    if map_get(tokens_result, "ok") == false {
        return map { "ok": false, "errors": map_get(tokens_result, "errors"), "ast": [] }
    }
    p = state(map_get(tokens_result, "tokens"))
    statements = []
    while kind(p) != "eof" {
        statements = array_push(statements, parse_stmt(p))
        accept(p, "semi")
    }
    return map { "ok": true, "errors": [], "ast": program(statements) }
}
